<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Windows>
		<FullResizeImage name="CombatLogToggleBackgroundTemplate" inherits="EA_FullResizeImage_TintableSolidBackground">
			<Size>
				<AbsPoint x="" y="" />
			</Size>
			<Anchors>
				<Anchor point="topleft" relativeTo="" relativePoint="topleft" />
				<Anchor point="bottomright" relativeTo="" relativePoint="bottomright" />
			</Anchors>
		</FullResizeImage>
		<Window name="CombatLogToggle" inherits="EA_Window_Default" movable="true" layer="secondary" savesettings="true" handleinput="true">
			<Size>
				<AbsPoint x="150" y="44" />
			</Size>
			<Anchors>
				<Anchor point="topleft" relativePoint="topleft">
					<AbsPoint x="40" y="80" />
				</Anchor>
			</Anchors>
			<EventHandlers>
				<EventHandler event="OnLButtonUp" function="CombatLogToggle.Toggle" />
				<EventHandler event="OnRButtonUp" function="CombatLogToggle.ShowContextMenu" />
			</EventHandlers>
			<Windows>
				<FullResizeImage name="$parentBackground" inherits="CombatLogToggleBackgroundTemplate" handleinput="false" />
				<Label name="$parentTitle" inherits="EA_Settings_ItemTitle" textalign="center">
					<Size>
						<AbsPoint x="150" y="20" />
					</Size>
					<Anchors>
						<Anchor point="top" relativeTo="" relativePoint="top">
							<AbsPoint x="0" y="1" />
						</Anchor>
					</Anchors>
				</Label>
				<Label name="$parentStatus" font="font_clear_small_bold" textalign="center">
					<Size>
						<AbsPoint x="150" y="20" />
					</Size>
					<Anchors>
						<Anchor point="bottom" relativeTo="" relativePoint="bottom">
							<AbsPoint x="0" y="-1" />
						</Anchor>
					</Anchors>
				</Label>
			</Windows>
		</Window>
		<Window name="CombatLogToggleOpacity" movable="true" layer="popup">
			<Size>
				<AbsPoint x="200" y="90" />
			</Size>
			<Windows>
				<Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />
				<Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
					<EventHandlers>
						<EventHandler event="OnLButtonUp" function="CombatLogToggle.CloseOpacity" />
					</EventHandlers>
				</Button>
				<Window name="$parentBackground" inherits="EA_Window_DefaultFrame">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft">
							<AbsPoint x="0" y="32" />
						</Anchor>
						<Anchor point="bottomright" relativePoint="bottomright">
							<AbsPoint x="0" y="0" />
						</Anchor>
					</Anchors>
				</Window>
				<SliderBar name="$parentSlider" inherits="EA_Default_SliderBar">
					<Size>
						<AbsPoint x="140" y="33" />
					</Size>
					<Anchors>
						<Anchor point="left" relativePoint="left">
							<AbsPoint x="30" y="13" />
						</Anchor>
					</Anchors>
					<EventHandlers>
						<EventHandler event="OnSlide" function="CombatLogToggle.OnOpacitySlide" />
					</EventHandlers>
				</SliderBar>
			</Windows>
		</Window>
	</Windows>
</Interface>






